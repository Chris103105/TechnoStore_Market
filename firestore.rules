rules_version = '2';

// Reglas de seguridad de Cloud Firestore para TechnoStore Market.
// Pegar en: Consola de Firebase -> Firestore Database -> Reglas -> Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // Catálogo: lo leen los usuarios autenticados.
    // La escritura se permite a usuarios autenticados SOLO para que la app pueda subir
    // el catálogo inicial la primera vez. Para producción, cambiar a `allow write: if false;`
    // y administrar el catálogo desde la consola.
    match /productos/{idProducto} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /categorias/{idCategoria} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Cada usuario solo puede leer y escribir su propio documento y subcolecciones.
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /carrito/{idProducto} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /pedidos/{idPedido} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
